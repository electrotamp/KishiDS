<UserControl x:Class="KishiDS.Pages.CalibrationPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:KishiDS.Controls">
    <ScrollViewer>
        <Grid Margin="0,0,14,60">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="1040"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel>
            <TextBlock Text="Calibration" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Measure your own sticks and triggers for the most accurate response, and choose how fast the controller reports." Style="{StaticResource Caption}" Margin="0,4,0,0"/>

            <Grid Margin="0,22,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="400"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Wizard -->
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel DataContext="{Binding Calibration}">
                            <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}" FontSize="17"/>
                            <TextBlock Text="{Binding Instruction}" Style="{StaticResource Caption}" Margin="0,6,0,0" FontSize="13"/>

                            <ProgressBar Style="{StaticResource ModernProgress}" Minimum="0" Maximum="1" Value="{Binding CenterProgress, Mode=OneWay}" Margin="0,18,0,0"
                                         Visibility="{Binding IsCenter, Converter={StaticResource B2V}}"/>

                            <TextBlock Text="{Binding Message}" Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap" Margin="0,14,0,0" FontSize="12.5"/>

                            <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                                <Button Style="{StaticResource PrimaryButton}" Content="Start calibration" Click="Start_Click" Visibility="{Binding IsIdle, Converter={StaticResource B2V}}"/>
                                <Button Style="{StaticResource PrimaryButton}" Content="I've done both" Click="Finish_Click" Visibility="{Binding IsRange, Converter={StaticResource B2V}}"/>
                                <Button Style="{StaticResource PrimaryButton}" Content="Save to profile" Click="Save_Click" Visibility="{Binding IsReview, Converter={StaticResource B2V}}"/>
                                <Button Style="{StaticResource GhostButton}" Content="Cancel" Click="Cancel_Click" Margin="8,0,0,0" Visibility="{Binding IsRunning, Converter={StaticResource B2V}}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="24,20,24,6">
                        <c:ToggleRow Label="Use my calibration" Hint="Off uses the values stored by the original firmware."
                                     IsOn="{Binding S.UseCustomCalibration, Mode=TwoWay}"/>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="24,22,24,10">
                        <StackPanel>
                            <TextBlock Text="Report rate" Style="{StaticResource SectionTitle}" Margin="0,0,0,16"/>
                            <c:SliderRow Label="USB polling interval" Unit=" ms" Minimum="1" Maximum="8" Value="{Binding S.PollMs, Converter={StaticResource I2D}, Mode=TwoWay}"
                                         Hint="How often the host asks for input. 1 ms is the fastest (1000 Hz); the default is 5 ms."/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Live raw readings -->
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="24,20">
                    <StackPanel DataContext="{Binding Calibration}">
                        <TextBlock Text="Live sensor readings" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="Raw values from the controller (0–4095). The blue band is the range captured so far." Style="{StaticResource Caption}" Margin="0,3,0,14"/>
                        <c:RawBar Height="34" Label="Left stick X" Value="{Binding Live[4]}" Min="{Binding Min[4]}" Max="{Binding Max[4]}"/>
                        <c:RawBar Height="34" Label="Left stick Y" Value="{Binding Live[3]}" Min="{Binding Min[3]}" Max="{Binding Max[3]}"/>
                        <c:RawBar Height="34" Label="Right stick X" Value="{Binding Live[0]}" Min="{Binding Min[0]}" Max="{Binding Max[0]}"/>
                        <c:RawBar Height="34" Label="Right stick Y" Value="{Binding Live[1]}" Min="{Binding Min[1]}" Max="{Binding Max[1]}"/>
                        <c:RawBar Height="34" Label="Left trigger" Value="{Binding Live[5]}" Min="{Binding Min[5]}" Max="{Binding Max[5]}"/>
                        <c:RawBar Height="34" Label="Right trigger" Value="{Binding Live[2]}" Min="{Binding Min[2]}" Max="{Binding Max[2]}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
