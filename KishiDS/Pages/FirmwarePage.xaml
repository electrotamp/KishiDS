<UserControl x:Class="KishiDS.Pages.FirmwarePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:KishiDS.Controls"
             xmlns:core="clr-namespace:KishiDS.Core">
    <ScrollViewer>
        <Grid Margin="0,0,14,60">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="1040"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel>
            <TextBlock Text="Firmware" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Update the controller's firmware (needed only once to switch on live editing), or put the original firmware back." Style="{StaticResource Caption}" Margin="0,4,0,0"/>

            <!-- Warning: no copy of Razer's firmware saved yet -->
            <Border Margin="0,18,0,0" CornerRadius="16" Padding="22,16" Background="{StaticResource WarnSoftBrush}" BorderBrush="{StaticResource WarnBrush}" BorderThickness="1"
                    Visibility="{Binding ShowOriginalWarning, Converter={StaticResource B2V}}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="22" Foreground="{StaticResource WarnBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Save Razer's original firmware before you switch the controller" FontWeight="SemiBold" FontSize="14.5" TextWrapping="Wrap"/>
                        <TextBlock Style="{StaticResource Caption}" FontSize="13" Margin="0,3,0,0"
                                   Text="Switching replaces Razer's firmware, and it can't be read back from the controller afterwards. Without a saved copy you can't return to stock from this app."/>
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource GradientButton}" Content="Show me how" Click="Guide_Click" Padding="18,10" Margin="18,0,0,0" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="340"/>
                </Grid.ColumnDefinitions>

                <!-- Flow -->
                <Border Style="{StaticResource Card}" Padding="34,30">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <c:RingProgress Height="150" Value="{Binding Progress}" State="{Binding Phase, Converter={StaticResource Phase2State}}" Spinning="{Binding Phase, Converter={StaticResource PhaseSpin}}"/>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding FlowTitle}" Style="{StaticResource SectionTitle}" FontSize="21" FontFamily="{StaticResource DisplayFont}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding FlowDetail}" Style="{StaticResource Caption}" Margin="0,8,0,0" FontSize="13.5"/>
                            </StackPanel>
                        </Grid>

                        <!-- Entering update mode -->
                        <Border Margin="0,26,0,0" CornerRadius="14" Background="{StaticResource PanelInsetBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" Padding="22,18"
                                Visibility="{Binding ShowSteps, Converter={StaticResource B2V}}">
                            <StackPanel>
                                <TextBlock Text="Enter update mode" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10"><Border Width="24" Height="24" CornerRadius="12" Background="{StaticResource AccentSoftBrush}"><TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource AccentHiBrush}" FontWeight="SemiBold" FontSize="12"/></Border><TextBlock Text="Unplug the Kishi from the computer." Margin="12,0,0,0" VerticalAlignment="Center"/></StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10"><Border Width="24" Height="24" CornerRadius="12" Background="{StaticResource AccentSoftBrush}"><TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource AccentHiBrush}" FontWeight="SemiBold" FontSize="12"/></Border><TextBlock Text="Press and hold Y + B + the Right Function button." Margin="12,0,0,0" VerticalAlignment="Center"/></StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10"><Border Width="24" Height="24" CornerRadius="12" Background="{StaticResource AccentSoftBrush}"><TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource AccentHiBrush}" FontWeight="SemiBold" FontSize="12"/></Border><TextBlock Text="Plug it back in while still holding them." Margin="12,0,0,0" VerticalAlignment="Center"/></StackPanel>
                                <StackPanel Orientation="Horizontal"><Border Width="24" Height="24" CornerRadius="12" Background="{StaticResource AccentSoftBrush}"><TextBlock Text="4" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource AccentHiBrush}" FontWeight="SemiBold" FontSize="12"/></Border><TextBlock Text="Let go once this page says the bootloader is detected." Margin="12,0,0,0" VerticalAlignment="Center"/></StackPanel>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,26,0,0">
                            <Button Style="{StaticResource PrimaryButton}" Content="Apply to controller" Command="{Binding ApplyCommand}" Visibility="{Binding CanStart, Converter={StaticResource B2V}}" Margin="0,0,10,0"/>
                            <Button Style="{StaticResource PrimaryButton}" Content="Flash now" Command="{Binding FlashNowCommand}" Visibility="{Binding ShowSteps, Converter={StaticResource B2V}}" Margin="0,0,10,0"/>
                            <Button Style="{StaticResource SecondaryButton}" Content="Cancel" Command="{Binding CancelFlowCommand}" Visibility="{Binding ShowSteps, Converter={StaticResource B2V}}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Original firmware -->
                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Original firmware" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,14"
                                       Text="Put your Kishi back exactly as it came from Razer. KishiDS keeps a verified copy taken from Razer's own Android app (.apk) or the firmware file (.bin). Drag either one onto this window."/>
                            <Border CornerRadius="10" Padding="12,9" Margin="0,0,0,14">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource WarnSoftBrush}"/>
                                        <Style.Triggers><DataTrigger Binding="{Binding HasStock}" Value="True"><Setter Property="Background" Value="{StaticResource GoodSoftBrush}"/></DataTrigger></Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" FontSize="14" VerticalAlignment="Center" Text="{Binding StockGlyph}"/>
                                    <TextBlock Text="{Binding StockStatus}" Margin="10,0,0,0" FontSize="12.5" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Button Style="{StaticResource SecondaryButton}" Content="Find it for me" Click="Find_Click" Margin="0,0,0,8"
                                    Visibility="{Binding HasStock, Converter={StaticResource InvB2V}}"/>
                            <Button Style="{StaticResource SecondaryButton}" Content="Choose a file..." Click="Import_Click" Margin="0,0,0,8"/>
                            <Button Style="{StaticResource GhostButton}" Content="How do I get it?" Click="Guide_Click" Margin="0,0,0,8" HorizontalAlignment="Left"
                                    Visibility="{Binding HasStock, Converter={StaticResource InvB2V}}"/>
                            <Button Style="{StaticResource SecondaryButton}" Content="Restore original firmware" Command="{Binding RestoreCommand}"/>
                        </StackPanel>
                    </Border>
                    <Button Style="{StaticResource SecondaryButton}" Click="Tutorial_Click" Margin="0,14,0,0" Padding="16,11">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE897;" FontSize="16" Foreground="{StaticResource TextBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Replay welcome tutorial" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Style="{StaticResource Caption}" Margin="6,14,6,0"
                               Text="Your Kishi can always be put back into update mode with the button combination, even if a setting makes it behave strangely."/>
                </StackPanel>
            </Grid>

            <Expander Margin="0,16,0,0" Header="Technical log" Foreground="{StaticResource TextDimBrush}" FontFamily="{StaticResource UiFont}">
                <Border Style="{StaticResource Card}" Padding="14" Margin="0,8,0,0">
                    <TextBox Text="{Binding Log, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource ModernTextBox}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                             MinHeight="120" TextWrapping="Wrap" Padding="12,10" VerticalContentAlignment="Top"/>
                </Border>
            </Expander>
        </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
