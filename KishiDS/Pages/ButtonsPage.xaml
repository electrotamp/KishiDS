<UserControl x:Class="KishiDS.Pages.ButtonsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:KishiDS.Controls">
    <ScrollViewer>
        <Grid Margin="0,0,14,60">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="1040"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel>
            <TextBlock Text="Buttons" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Choose what each physical button does. Hold a button on the controller and its row lights up." Style="{StaticResource Caption}" Margin="0,4,0,0"/>

            <Grid Margin="0,22,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="380"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Padding="14,12">
                    <ItemsControl ItemsSource="{Binding S.Buttons}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="12" Padding="12,8" Margin="0,2">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Pressed}" Value="True"><Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="170"/>
                                            <ColumnDefinition Width="34"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="44"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{StaticResource DotIdleBrush}"/>
                                                        <Style.Triggers><DataTrigger Binding="{Binding Pressed}" Value="True"><Setter Property="Background" Value="{StaticResource AccentHiBrush}"/></DataTrigger></Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Style="{StaticResource Icon}" Text="&#xE72A;" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        <ComboBox Grid.Column="2" Style="{StaticResource ModernComboBox}" ItemsSource="{Binding Options}" SelectedIndex="{Binding Output, Mode=TwoWay}"/>
                                        <Button Grid.Column="3" Style="{StaticResource GhostButton}" Margin="6,0,0,0" ToolTip="Reset to default" Click="ResetRow_Click"
                                                Visibility="{Binding IsDefault, Converter={StaticResource InvB2V}}">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE777;" FontSize="13"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Card}" Padding="14,18">
                        <c:ControllerView Height="190" Input="{Binding Live}" ButtonMask="{Binding Tele.ButtonMask, FallbackValue=0}" IsV2Pro="{Binding S.IsV2Pro}" LedColor="{Binding S.LedColor}" Connected="{Binding IsConnected}" LedMode="{Binding S.LedMode, Mode=OneWay}"/>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="Quick changes" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="Common layouts in one click." Style="{StaticResource Caption}" Margin="0,3,0,14"/>
                            <Button Style="{StaticResource SecondaryButton}" Content="Swap A and B" Click="SwapAB_Click" Margin="0,0,0,8" HorizontalContentAlignment="Left"/>
                            <Button Style="{StaticResource SecondaryButton}" Content="Swap X and Y" Click="SwapXY_Click" Margin="0,0,0,8"/>
                            <Button Style="{StaticResource SecondaryButton}" Content="Swap L1/R1 with L2/R2" Click="SwapShoulders_Click" Margin="0,0,0,8"/>
                            <Button Style="{StaticResource GhostButton}" Content="Reset all buttons" Click="ResetAll_Click"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Style="{StaticResource Caption}" Margin="6,14,6,0"
                               Text="Mapping a button to L2 or R2 presses that trigger fully. Mapping a button to a D-pad direction works like pressing that direction."/>
                </StackPanel>
            </Grid>
        </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
